FROM alpine:3.20 AS image-extractor

COPY x86_64-28_r04.zip /tmp/x86_64-28_r04.zip

RUN mkdir /image && unzip -q /tmp/x86_64-28_r04.zip -d /image

FROM us-docker.pkg.dev/android-emulator-268719/images/30-google-x64:30.1.2

USER root

RUN rm -rf /android/sdk/system-images/android/x86_64

COPY --from=image-extractor /image/x86_64 /android/sdk/system-images/android/x86_64
