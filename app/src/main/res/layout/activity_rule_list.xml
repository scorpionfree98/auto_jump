<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/page_background">
  <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" android:background="@color/page_background" android:paddingStart="8dp" app:title="工具合集" app:titleTextColor="@color/text_primary"/>
  <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="我的快捷指令" android:textAppearance="@style/TextAppearance.AutoJump.PageTitle" android:layout_marginTop="8dp"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="打开页面 → 等待 → 自动点击" android:textAppearance="@style/TextAppearance.AutoJump.Caption" android:layout_marginTop="8dp"/>
      <Space android:layout_width="1dp" android:layout_height="20dp"/>
      <com.google.android.material.card.MaterialCardView style="@style/Widget.AutoJump.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
          <TextView android:id="@+id/tv_home_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="正在读取运行状态" android:textAppearance="@style/TextAppearance.AutoJump.Body" android:layout_marginTop="8dp"/>
          <com.google.android.material.button.MaterialButton android:id="@+id/btn_permissions" style="@style/Widget.AutoJump.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="查看权限与运行状态"/>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="指令库" android:textAppearance="@style/TextAppearance.AutoJump.SectionTitle"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_add_rule" style="@style/Widget.AutoJump.Button.Text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="＋ 创建指令"/>
      </LinearLayout>
      <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_rules" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false"/>
      <LinearLayout android:id="@+id/empty_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:visibility="gone">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="把常用操作存成指令" android:textAppearance="@style/TextAppearance.AutoJump.SectionTitle" android:layout_marginTop="8dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="设置目标页面，录制要点击的按钮。保存后就能一键运行。" android:textAppearance="@style/TextAppearance.AutoJump.Caption" android:layout_marginTop="8dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_empty_add_rule" style="@style/Widget.AutoJump.Button.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="创建第一条指令"/>
      </LinearLayout>
      <com.google.android.material.button.MaterialButton android:id="@+id/btn_test_run" style="@style/Widget.AutoJump.Button.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="运行默认指令"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="按触发顺序排队，轮到执行时检查已配置条件。" android:textAppearance="@style/TextAppearance.AutoJump.Caption" android:layout_marginTop="8dp"/>
      <Space android:layout_width="1dp" android:layout_height="24dp"/>
      <com.google.android.material.card.MaterialCardView style="@style/Widget.AutoJump.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="默认指令" android:textAppearance="@style/TextAppearance.AutoJump.SectionTitle" android:layout_marginTop="8dp"/>
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="普通点击图标或手机自动助手启动时，执行这一条指令。" android:textAppearance="@style/TextAppearance.AutoJump.Caption" android:layout_marginTop="8dp"/>
          <TextView android:id="@+id/tv_default_deeplink" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:singleLine="true" android:ellipsize="middle" android:textAppearance="@style/TextAppearance.AutoJump.Caption"/>
          <com.google.android.material.button.MaterialButton android:id="@+id/btn_edit_default_link" style="@style/Widget.AutoJump.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="选择默认指令"/>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.button.MaterialButton android:id="@+id/btn_tools" style="@style/Widget.AutoJump.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="地图与工具 · 高德 / 收藏 / 硬件 / 测速" />
<TextView android:id="@+id/tv_shortcut_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textAppearance="@style/TextAppearance.AutoJump.Caption" />
<com.google.android.material.button.MaterialButton android:id="@+id/btn_shortcut_retry" style="@style/Widget.AutoJump.Button.Text" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="重试同步快捷菜单" />
</LinearLayout>
  </androidx.core.widget.NestedScrollView>
</LinearLayout>
