<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="点击动作"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="优先按控件特征查找，找不到时可使用相对坐标。目标应用之外不会执行。" />

        <TextView
            android:id="@+id/tv_service_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_open_accessibility_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="打开无障碍设置" />

        <EditText
            android:id="@+id/et_target_package"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="目标应用包名（必填）"
            android:inputType="textNoSuggestions" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/et_click_delay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="点击延迟 ms"
                android:inputType="number"
                android:text="1000" />

            <EditText
                android:id="@+id/et_click_timeout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="超时 ms"
                android:inputType="number"
                android:text="15000" />
        </LinearLayout>

        <EditText
            android:id="@+id/et_retry_interval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="查找重试间隔 ms"
            android:inputType="number"
            android:text="500" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="控件特征（至少填写一项，记录按钮可自动填写）"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_target_view_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="控件 ID，如 com.example:id/confirm"
            android:inputType="textNoSuggestions" />

        <EditText
            android:id="@+id/et_target_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="控件文字，如 确认"
            android:inputType="text" />

        <EditText
            android:id="@+id/et_target_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="无障碍描述"
            android:inputType="text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="备用相对坐标（0 到 1，X/Y 需同时填写）"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/et_relative_x"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="X，如 0.5"
                android:inputType="numberDecimal" />

            <EditText
                android:id="@+id/et_relative_y"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Y，如 0.8"
                android:inputType="numberDecimal" />
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_continue_on_failure"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="点击失败时继续后续动作" />

        <Button
            android:id="@+id/btn_record_click"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="记录下一次点击" />

        <Button
            android:id="@+id/btn_save_click_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="保存点击动作"
            android:textSize="16sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="24dp" />
    </LinearLayout>
</ScrollView>
